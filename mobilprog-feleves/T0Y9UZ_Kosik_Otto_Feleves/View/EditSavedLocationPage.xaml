<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="T0Y9UZ_Kosik_Otto_Feleves.View.EditSavedLocationPage"
             Title="EditSavedLocationPage">
    <VerticalStackLayout
        BackgroundColor="{Binding BackgroundColor}"
        Padding="50">
        <Border
            Stroke="Black"
            StrokeShape="RoundRectangle 20,20,20,20"
            Padding="10"
            BackgroundColor="Coral">

            <VerticalStackLayout
                Spacing="10">
                <Label 
                    Text="Update Location"
                    HorizontalTextAlignment="Center"
                    FontSize="30"
                    TextColor="{Binding TextColor}"/>

                <Label 
                    Text="{Binding SavedLocation.Location, StringFormat='Old location name: {0}'}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{Binding TextColor}"/>

                <Entry
                    x:Name="NewLocationEntry"
                    Placeholder="New Location name"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Text="{Binding NewSavedLocation}"
                    WidthRequest="150"
                    TextColor="{Binding TextColor}"/>

                <Button 
                    Text="Save"
                    FontSize="20"
                    Command="{Binding DoTheUpdateCommand}"
                    TextColor="{Binding TextColor}"
                    BackgroundColor="Green"
                    FontAttributes="Bold"/>

                <Button 
                    Text="Cancel"
                    FontSize="20"
                    Command="{Binding CancelUpdateCommand}"
                    TextColor="{Binding TextColor}"
                    BackgroundColor="Red"
                    FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>